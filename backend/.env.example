PORT=3000

# Convex dev deployment
CONVEX_URL=https://your-deployment-name.convex.cloud

# GitHub token (fine-grained PAT preferred, scoped to side-project repos)
GITHUB_TOKEN=

# Provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google OAuth (for Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# Existing refresh token if you already did the OAuth dance elsewhere
GOOGLE_REFRESH_TOKEN=

# AES-256 key (base64) for encrypting integration tokens at rest in Convex
# generate with: openssl rand -base64 32
INTEGRATION_ENC_KEY=
