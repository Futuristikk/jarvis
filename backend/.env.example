PORT=3000

# Convex dev deployment (us-east, S16)
CONVEX_URL=https://fastidious-mouse-703.convex.cloud

# GitHub PAT (fine-grained, scoped to side-project repos) — leave blank locally until needed
GITHUB_PAT=

# Provider keys
