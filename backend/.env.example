OPENAI_API_KEY=

# Google OAuth (for Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Token encryption key (base64, used to encrypt integration tokens at rest in Convex)
INTEGRATION_ENC_KEY=
