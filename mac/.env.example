# Path to the Obsidian vault on this Mac. Required.
VAULT_PATH=

# Port to listen on. Default 3001.
PORT=3001

# Bind address. Default 0.0.0.0 so Tailscale can reach it.
HOST=0.0.0.0

# Shared secret required on every request as `X-Mac-Auth` header.
# Generate with: openssl rand -base64 32
# Backend's MAC_VAULT_SECRET must match. Leave blank to disable auth (dev only).
MAC_VAULT_SECRET=
