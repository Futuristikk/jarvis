{
  "name": "jarvis-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Jarvis PWA — primary client, talks to the TS backend",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "marked": "^18.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/local-notifications": "^8.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "@capacitor/cli": "^8.4.2"
  }
}
