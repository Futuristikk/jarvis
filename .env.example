# Convex dev deployment
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment-name.convex.cloud

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Research / web search
FIRECRAWL_API_KEY=

# GitHub fine-grained PAT (Pi-Mono coding agents, side-project repo access).
# Scope to specific repos with Contents: read/write, Pull requests: read/write, Metadata: read.
GITHUB_PAT=

# Obsidian vault root (the local filesystem path to your synced vault)
VAULT_PATH=
